{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kuriangeorgebinu/proto2prod/schemas/app-profile.schema.json",
  "title": "proto2prod app profile",
  "description": "Facts the analyzer found about the app, plus the user's traffic tier and budget.",
  "type": "object",
  "required": [
    "version",
    "adapter",
    "framework",
    "runtime",
    "build",
    "services",
    "database",
    "traffic_tier",
    "monthly_budget_usd"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "adapter": {
      "description": "Stack adapter that handles detection, build and refactor. 'generic' = any containerizable app: full infra, CI/CD and review, but no deep refactor.",
      "enum": [
        "nextjs",
        "generic"
      ]
    },
    "framework": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "e.g. nextjs, fastapi, django, express, rails, unknown"
        },
        "version": {
          "type": "string"
        },
        "router": {
          "enum": [
            "app",
            "pages"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "type": "string",
          "description": "e.g. typescript, javascript, python, ruby, java, go"
        },
        "version": {
          "type": "string"
        },
        "package_manager": {
          "type": "string"
        }
      }
    },
    "container": {
      "type": "object",
      "properties": {
        "dockerfile": {
          "type": "string",
          "description": "Path to an existing Dockerfile, if any"
        },
        "generated": {
          "type": "boolean",
          "description": "True if proto2prod must write the Dockerfile"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "install": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "test": {
          "type": "string"
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "web",
              "worker",
              "cron"
            ]
          },
          "schedule": {
            "type": "string"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "engine"
      ],
      "properties": {
        "engine": {
          "enum": [
            "postgres",
            "mysql",
            "none"
          ]
        },
        "version": {
          "type": "string"
        },
        "orm": {
          "type": "string",
          "description": "e.g. prisma, drizzle, sqlalchemy, django-orm, activerecord, none"
        },
        "migrations": {
          "type": "string",
          "description": "e.g. prisma-migrate, alembic, django, none"
        },
        "row_level_security": {
          "enum": [
            "enabled",
            "disabled",
            "unknown",
            "not-applicable"
          ]
        }
      }
    },
    "external_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "description": "Production-readiness issues the analyzer spotted, for the refactor agent and the user.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    },
    "uncertain": {
      "type": "array",
      "description": "Things the analyzer could not determine and will not guess.",
      "items": {
        "type": "string"
      }
    },
    "traffic_tier": {
      "enum": [
        "starter",
        "standard",
        "growth"
      ]
    },
    "monthly_budget_usd": {
      "type": "number",
      "minimum": 0
    }
  }
}
