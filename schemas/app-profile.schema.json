{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kuriangeorgebinu/proto2prod/schemas/app-profile.schema.json",
  "title": "proto2prod app profile",
  "description": "Facts the analyzer found about the app, plus the user's traffic tier and budget.",
  "type": "object",
  "required": ["version", "framework", "runtime", "build", "services", "database", "traffic_tier", "monthly_budget_usd"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "framework": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "enum": ["nextjs"] },
        "version": { "type": "string" },
        "router": { "enum": ["app", "pages"] }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["language", "package_manager"],
      "properties": {
        "language": { "enum": ["typescript", "javascript"] },
        "node_version": { "type": "string" },
        "package_manager": { "enum": ["npm", "pnpm", "yarn", "bun"] }
      }
    },
    "build": {
      "type": "object",
      "required": ["install", "build", "start"],
      "properties": {
        "install": { "type": "string" },
        "build": { "type": "string" },
        "start": { "type": "string" },
        "test": { "type": "string" }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["web", "worker", "cron"] },
          "schedule": { "type": "string" }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": { "enum": ["postgres", "none"] },
        "version": { "type": "string" },
        "orm": { "enum": ["prisma", "drizzle", "supabase-js", "pg", "none"] },
        "migrations": { "enum": ["prisma-migrate", "drizzle-kit", "supabase", "none"] },
        "row_level_security": { "enum": ["enabled", "disabled", "unknown", "not-applicable"] }
      }
    },
    "external_services": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "description": "Production-readiness issues the analyzer spotted, for the refactor agent and the user.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "summary": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    },
    "uncertain": {
      "type": "array",
      "description": "Things the analyzer could not determine and will not guess.",
      "items": { "type": "string" }
    },
    "traffic_tier": { "enum": ["starter", "standard", "growth"] },
    "monthly_budget_usd": { "type": "number", "minimum": 0 }
  }
}
